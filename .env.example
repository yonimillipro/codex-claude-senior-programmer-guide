# Server-only values: configure Secrets in Vercel, never in chat or browser code.
OPENAI_API_KEY=
CHAT_MODEL=gpt-6-luna
CHAT_ENABLED=false
# Connect an Upstash Redis REST database for atomic, distributed usage limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Owner must choose a limit before public usage is enabled. This counts requests,
# not dollars, and is not a substitute for provider-side spend controls.
CHAT_DAILY_REQUEST_LIMIT=
CHAT_IP_HOURLY_LIMIT=20
CHAT_ALLOWED_ORIGINS=http://127.0.0.1:4176,http://localhost:4176
