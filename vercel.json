{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] }
  ],
  "functions": { "api/chat.js": { "maxDuration": 60, "supportsCancellation": true } }
}
